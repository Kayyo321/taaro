# Copy to .env or generate automatically via `make setup`.
# Never commit .env or .pem private keys.

# HTTP server bind address and public base URL (used for Check Run details_url and manifest callback)
TAARO_LISTEN_ADDR=127.0.0.1:8080
TAARO_PUBLIC_URL=http://127.0.0.1:8080

# GitHub App credentials (populated automatically by `make setup`)
TAARO_APP_ID=
TAARO_APP_SLUG=
TAARO_WEBHOOK_SECRET=
TAARO_PRIVATE_KEY_PATH=.secrets/taaro-dev.pem
TAARO_CLIENT_ID=
TAARO_CLIENT_SECRET=

# Local webhook forwarding (used by `make smee` and pre-filled by `make setup`)
TAARO_SMEE_URL=

# Embedded SQLite database path
TAARO_DB_PATH=.data/taaro.db

# Bearer token protecting repository handoff pages and /api/v1/* (required off loopback)
TAARO_API_TOKEN=

# Optional: set to 1 to automatically publish the dedicated required "Taaro Awareness Check" on PR events
TAARO_ENABLE_AWARENESS_CHECK=0

# Optional debugging: set to 1 (or a directory path) to save raw incoming webhooks locally
TAARO_DUMP_WEBHOOKS=

# Logging level: debug, info, warn, error
TAARO_LOG_LEVEL=debug

# CLI target server URL (export in the CLI shell if overriding the default)
TAARO_SERVER_URL=http://127.0.0.1:8080
